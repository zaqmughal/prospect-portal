{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["signals"],
  "properties": {
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "severity", "title", "description", "evidence"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["content", "ux", "tech", "opportunity"],
            "description": "The category of signal"
          },
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Impact severity"
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "description": "Brief title for the signal"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "Explanation of the signal and its impact"
          },
          "evidence": {
            "type": "string",
            "maxLength": 300,
            "description": "Direct quote or snippet from the content"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
