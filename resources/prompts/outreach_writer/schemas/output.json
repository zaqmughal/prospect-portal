{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["linkedin_dm", "email"],
  "properties": {
    "linkedin_dm": {
      "type": "string",
      "maxLength": 300,
      "description": "LinkedIn direct message (under 300 chars)"
    },
    "email": {
      "type": "object",
      "required": ["subject", "body"],
      "properties": {
        "subject": {
          "type": "string",
          "maxLength": 100,
          "description": "Email subject line (required, non-empty)"
        },
        "body": {
          "type": "string",
          "description": "Email body content (required, non-empty)"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
