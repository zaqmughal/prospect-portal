{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["company_name", "sector", "services"],
  "properties": {
    "company_name": {
      "type": ["string", "null"],
      "description": "The company name as it appears on the website"
    },
    "sector": {
      "type": ["string", "null"],
      "description": "Primary sector/industry"
    },
    "size_band": {
      "type": ["string", "null"],
      "enum": ["1-10", "11-50", "51-200", "201-500", "500+", null],
      "description": "Estimated company size"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of services or products offered"
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Technologies, platforms, or tools mentioned"
    },
    "location": {
      "type": ["string", "null"],
      "description": "Headquarters or primary location"
    },
    "copyright_year": {
      "type": ["integer", "null"],
      "description": "Copyright year from footer"
    }
  },
  "additionalProperties": false
}
