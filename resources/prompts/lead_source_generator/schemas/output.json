{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "queries"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Short descriptive name for the lead source",
      "minLength": 1,
      "maxLength": 255
    },
    "queries": {
      "type": "array",
      "description": "Search queries for Google/web discovery",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "additionalProperties": false
}
